# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ / Android Studio
# 说明：.idea/ 下绝大多数是 IDE 私有配置，不同机器上内容不同（例如 misc.xml 会记录本机 JDK 路径），
# 提交到仓库只会造成无意义的 diff 与冲突，因此整体忽略。
# 若将来确实要共享某项配置（如 codeStyles），再用 !.idea/xxx.xml 单独放行。
.idea/
*.iml

# Kotlin 编译缓存
.kotlin/

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/