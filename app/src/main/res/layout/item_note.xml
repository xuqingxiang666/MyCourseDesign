<?xml version="1.0" encoding="utf-8"?>
<!--
  笔记列表的单个条目。
  【为什么用 MaterialCardView 而不是 androidx.cardview.widget.CardView】
  MaterialCardView 已包含在 material:1.12.0 依赖中，功能完全一致且多了
  stroke / ripple 等特性，这样项目无需再引入 androidx.cardview 依赖。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
          颜色使用主题属性 ?attr/colorOnSurface 而非硬编码 #333333，
          这样暗色模式（values-night）下文字会自动变成浅色，不会出现"黑底黑字"。
        -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="笔记标题" />

        <TextView
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            tools:text="笔记内容预览…" />

        <!-- 置顶/归档状态标记，后续阶段使用 -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="已置顶"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
